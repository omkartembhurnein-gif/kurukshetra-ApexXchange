# ========================================================
# AgentXchange Environment Configuration
# ========================================================

# Server Port
PORT=3001

# Execution Mode: 'demo' (zero gas sandbox) or 'live' (testnet blockchain settlement)
MODE=demo

# Active Network: 'eip155:84532' (Base Sepolia) or 'eip155:421614' (Arbitrum Sepolia)
NETWORK=eip155:84532

# Database Path
DATABASE_PATH=./data/agentxchange.sqlite

# x402 Facilitator URL
FACILITATOR_URL=https://x402.org/facilitator

# --------------------------------------------------------
# LIVE TESTNET SETTINGS (Optional - Required only if MODE=live)
# --------------------------------------------------------
# Dedicated testnet buyer private key (64 hex characters)
# BUYER_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Seller Payout Wallets (Base Sepolia EVM addresses)
SELLER_SCRAPER_ADDRESS=0x71C94142D3cC66c0d8E14101A2e2697b09B8Bf9b
SELLER_DATA_ADDRESS=0x534c071dC519280a5eE42689531Ce97d620Bfc28
SELLER_INFERENCE_ADDRESS=0x8892c9E5336d39572bAcbbC443a90325d97034B9

# Spending Limit Safeguards (USDC)
MAX_RUN_BUDGET=0.05
MAX_DAILY_SPEND=0.20

# Optional OpenAI API Key (For live LLM Hindi generation, falls back to deterministic AI engine if omitted)
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini
